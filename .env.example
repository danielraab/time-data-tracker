# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL of the app (used for OAuth redirect URIs and magic-link URLs).
BETTER_AUTH_URL=http://localhost:3000

# Client-side mirror — only needed if your auth server runs on a different origin.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ─── better-auth secret ──────────────────────────────────────────────────────
# Required: at least 32 random characters.  Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string

# ─── Database (SQLite) ───────────────────────────────────────────────────────
# Path to the SQLite file (relative to the project root or absolute).
DATABASE_URL=./tidatra.db

# ─── SMTP (magic-link sign-in) ───────────────────────────────────────────────
# Dev container default: Mailpit catches all outgoing mail — no auth, no TLS.
# Open http://localhost:8025 to read sent messages.
# In development you may also omit all SMTP_* vars: the magic link URL is then
# printed to the server console instead.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Set to "true" for implicit TLS (port 465); leave "false" for STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when not set.
SMTP_FROM=TiDaTra <no-reply@tidatra.local>

# ─── CouchDB sync (Phase 3) ──────────────────────────────────────────────────
# Base URL of the CouchDB server (no database path). The server creates a
# per-user database (tidatra_<userId>) automatically on first sync.
# Dev container default: admin / password on localhost:5984.
COUCHDB_URL=http://couchdb:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# ─── OAuth providers ─────────────────────────────────────────────────────────
# GitHub — Create an OAuth App at https://github.com/settings/developers
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google — Create credentials at https://console.cloud.google.com/apis/credentials
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authentik (or any OIDC provider)
# Callback URL: ${BETTER_AUTH_URL}/api/auth/oauth2/callback/authentik
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER=https://auth.your-domain.com/application/o/tidatra

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Both snippets are injected at the top of <body> (HEAD_SNIPPET first, then
# BODY_SNIPPET). The app renders them server-side — no NEXT_PUBLIC_ prefix
# needed, and no image rebuild required; just update your .env and restart.
#
# Multiline values must be collapsed to a single line or quoted in the .env file.
#
# Umami:
# ANALYTICS_HEAD_SNIPPET=<script defer src="https://umami.example.com/script.js" data-website-id="YOUR-ID"></script>
# ANALYTICS_BODY_SNIPPET=
#
# Plausible:
# ANALYTICS_HEAD_SNIPPET=<script defer data-domain="yourdomain.com" src="https://plausible.io/js/script.js"></script>
# ANALYTICS_BODY_SNIPPET=
#
# Google Tag Manager (script first, noscript after):
# ANALYTICS_HEAD_SNIPPET=<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-XXXX');</script>
# ANALYTICS_BODY_SNIPPET=<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
ANALYTICS_HEAD_SNIPPET=
ANALYTICS_BODY_SNIPPET=

